# Auto-detect text files and normalize line endings in the repository.
* text=auto

# World of Warcraft addon sources.
*.lua text eol=lf
*.toc text eol=lf
*.xml text eol=lf

# Documentation and editor/project files.
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.code-workspace text eol=lf

# Binary assets.
*.blp binary
*.dds binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.ttf binary
*.otf binary
*.mp3 binary
*.ogg binary
*.wav binary
